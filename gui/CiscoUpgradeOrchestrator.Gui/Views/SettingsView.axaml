<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CiscoUpgradeOrchestrator.Gui.ViewModels"
             x:Class="CiscoUpgradeOrchestrator.Gui.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="28,20,28,24" MaxWidth="920" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="Settings and Python runtime" Classes="pageTitle"/>
                <TextBlock Text="Configure theme, display scaling, Python virtual environment, and project root path"
                           Classes="caption"/>
            </StackPanel>

            <!-- Appearance Section -->
            <Border Classes="surfaceCard">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Appearance and scaling" Classes="sectionTitle"/>
                        <TextBlock Text="Theme stays synchronized across the title bar, settings, and Windows system changes"
                                   Classes="caption"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto">
                        <TextBlock Text="Application theme"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                  Height="32"
                                  Width="240">
                            <ComboBoxItem Content="System default"/>
                            <ComboBoxItem Content="Dark mode"/>
                            <ComboBoxItem Content="Light mode"/>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto">
                        <TextBlock Text="Display scale"
                                   FontSize="12"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Slider Grid.Column="1"
                                Minimum="0.8"
                                Maximum="1.5"
                                Margin="0,0,12,0"
                                Value="{Binding UiScale, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="subtle"
                                Height="32"
                                Command="{Binding ResetUiScaleCommand}">
                            <TextBlock Text="{Binding UiScale, StringFormat='Reset ({0:P0})'}" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Python Runtime Section -->
            <Border Classes="surfaceCard">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Python runtime and automation engine" Classes="sectionTitle"/>
                        <TextBlock Text="Select the Python virtual environment that has netmiko, paramiko, openpyxl, and pyyaml installed"
                                   Classes="caption"/>
                    </StackPanel>

                    <!-- Python Path Input & Actions -->
                    <Grid ColumnDefinitions="180,*,Auto,Auto,Auto">
                        <TextBlock Text="Python executable"
                                   FontSize="12"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding PythonExecutable, Mode=TwoWay}"
                                 Height="32"
                                 Margin="0,0,8,0"
                                 CornerRadius="6"
                                 FontFamily="{DynamicResource CodeFontFamily}"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="subtle"
                                Height="32"
                                Margin="0,0,6,0"
                                Command="{Binding BrowsePythonCommand}"
                                ToolTip.Tip="Browse for python.exe">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="OpenFolder" FontSize="13"/>
                                <TextBlock Text="Browse" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Classes="subtle"
                                Height="32"
                                Margin="0,0,6,0"
                                Command="{Binding AutoDetectPythonCommand}"
                                ToolTip.Tip="Auto-detect virtual environments and system Pythons">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="Find" FontSize="13"/>
                                <TextBlock Text="Auto-detect" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4"
                                Classes="accent"
                                Height="32"
                                Command="{Binding RunDiagnosticsCommand}"
                                ToolTip.Tip="Test Python execution and verify dependencies">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="Sync" FontSize="13"/>
                                <TextBlock Text="Test connection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Detected Interpreters Picker -->
                    <Grid ColumnDefinitions="180,*" IsVisible="{Binding AvailableInterpreters.Count}">
                        <TextBlock Text="Detected interpreters"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableInterpreters}"
                                  SelectedItem="{Binding PythonExecutable, Mode=TwoWay}"
                                  Height="32"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Project Root Path -->
                    <Grid ColumnDefinitions="180,*,Auto">
                        <TextBlock Text="Project root folder"
                                   FontSize="12"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ProjectRoot, Mode=TwoWay}"
                                 Height="32"
                                 Margin="0,0,8,0"
                                 CornerRadius="6"
                                 FontFamily="{DynamicResource CodeFontFamily}"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                Classes="subtle"
                                Height="32"
                                Command="{Binding BrowseProjectRootCommand}"
                                ToolTip.Tip="Select directory containing orchestrator.py and gui_bridge.py">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="OpenFolder" FontSize="13"/>
                                <TextBlock Text="Browse folder" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Diagnostics Status Box -->
                    <Border Classes="recessedBox" Padding="14,12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="statusDot"
                                         IsVisible="{Binding !HasError}"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <Ellipse Classes="statusDot"
                                         IsVisible="{Binding HasError}"
                                         Fill="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="{Binding TestStatus}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding PythonVersion}"
                                       FontSize="11.5"
                                       FontFamily="{DynamicResource CodeFontFamily}"
                                       IsVisible="{Binding PythonVersion.Length}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <!-- Error Traceback / Details -->
                            <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasError}">
                                <TextBlock Text="Diagnostic details" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                                <SelectableTextBlock Text="{Binding LastErrorDetails}"
                                                     FontSize="11.5"
                                                     FontFamily="{DynamicResource CodeFontFamily}"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dependency Verification List -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Dependency verification" Classes="fieldLabel" Margin="0"/>
                        <Border Classes="recessedBox" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                                            <Ellipse Grid.Column="0"
                                                     Classes="statusDot"
                                                     Margin="0,0,10,0"
                                                     IsVisible="{Binding Installed}"
                                                     Fill="{DynamicResource SuccessBrush}"/>
                                            <Ellipse Grid.Column="0"
                                                     Classes="statusDot"
                                                     Margin="0,0,10,0"
                                                     IsVisible="{Binding !Installed}"
                                                     Fill="{DynamicResource DangerBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontFamily="{DynamicResource CodeFontFamily}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusText}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CiscoUpgradeOrchestrator.Gui.ViewModels"
             x:Class="CiscoUpgradeOrchestrator.Gui.Views.PlannerView"
             x:DataType="vm:PlannerViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,20,28,20">

        <!-- Stage 2 Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Plan and canary batches" Classes="pageTitle"/>
                <TextBlock Text="Uses the switch cards configured in Stage 1 to build topology-isolated canary batches and preview IOS-XE commands"
                           Classes="caption"/>
            </StackPanel>

            <!-- Generated Job ID Pill -->
            <Border Grid.Column="1"
                    IsVisible="{Binding HasPlan}"
                    Classes="recessedBox"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="statusDot" Fill="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="Job" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding PlanJobId}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource CodeFontFamily}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel Spacing="16">

                <!-- Linked Stage 1 Inventory & Plan Generator Card -->
                <Border Classes="surfaceCard" Padding="20,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Ellipse Grid.Column="0" Classes="statusDot" Margin="0,0,10,0"
                                     IsVisible="{Binding IsStage1Ready}"
                                     Fill="{DynamicResource SuccessBrush}"/>
                            <Ellipse Grid.Column="0" Classes="statusDot" Margin="0,0,10,0"
                                     IsVisible="{Binding !IsStage1Ready}"
                                     Fill="{DynamicResource WarningBrush}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Stage1SourceSummary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{Binding InventoryFileDisplayName, StringFormat='Workbook: {0}'}"
                                           ToolTip.Tip="{Binding InventoryFilePath}"
                                           FontSize="11.5"
                                           FontFamily="{DynamicResource CodeFontFamily}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Classes="subtle"
                                    Height="32"
                                    Margin="8,0,8,0"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding BackToInventoryCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="Edit" FontSize="12"/>
                                    <TextBlock Text="Edit switches" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Classes="accent"
                                    Height="34"
                                    Padding="16,0"
                                    IsEnabled="{Binding !IsLoading}"
                                    Command="{Binding GeneratePlanCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:ProgressRing Width="13" Height="13" IsVisible="{Binding IsLoading}"/>
                                    <ui:SymbolIcon Symbol="Calendar" FontSize="13" IsVisible="{Binding !IsLoading}"/>
                                    <TextBlock Text="Generate plan" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Plan Status Line -->
                        <Border Classes="recessedBox" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="statusDot"
                                         IsVisible="{Binding HasPlan}"
                                         Fill="{DynamicResource SuccessBrush}"/>
                                <Ellipse Classes="statusDot"
                                         IsVisible="{Binding !HasPlan}"
                                         Fill="{DynamicResource InfoBrush}"/>
                                <TextBlock Text="{Binding SummaryText}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Staged Upgrade Batches Grid -->
                <Border Classes="surfaceCard" IsVisible="{Binding HasPlan}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Staged upgrade batches" Classes="sectionTitle"/>
                            <TextBlock Text="Canary batch runs first and must pass Genie pre/post health checks before production batches begin"
                                       Classes="caption"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Batches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="-6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BatchCardModel">
                                    <Border Width="290"
                                            Margin="6"
                                            Classes="recessedBox"
                                            Padding="16">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Ellipse Grid.Column="0"
                                                         Classes="statusDot"
                                                         Margin="0,0,8,0"
                                                         IsVisible="{Binding IsCanary}"
                                                         Fill="{DynamicResource WarningBrush}"/>
                                                <Ellipse Grid.Column="0"
                                                         Classes="statusDot"
                                                         Margin="0,0,8,0"
                                                         IsVisible="{Binding !IsCanary}"
                                                         Fill="{DynamicResource InfoBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DeviceCount, StringFormat='{}{0} dev'}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource CodeFontFamily}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                                            <ItemsControl ItemsSource="{Binding Devices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   FontFamily="{DynamicResource CodeFontFamily}"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   Margin="0,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Planned IOS-XE Command Sequence -->
                <Border Classes="surfaceCard" IsVisible="{Binding HasPlan}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Planned IOS-XE command sequence" Classes="sectionTitle"/>
                            <TextBlock Text="Install-mode workflow executed on each switch with auto-abort rollback protection"
                                       Classes="caption"/>
                        </StackPanel>

                        <Border Classes="recessedBox">
                            <ItemsControl ItemsSource="{Binding Commands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                            <ui:SymbolIcon Symbol="ChevronRight"
                                                           FontSize="11"
                                                           Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding}"
                                                                 FontFamily="{DynamicResource CodeFontFamily}"
                                                                 FontSize="12"
                                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Stage Bottom Action Bar -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Classes="subtle"
                    Height="36"
                    Padding="12,0"
                    IsEnabled="{Binding !IsLoading}"
                    Command="{Binding BackToInventoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:SymbolIcon Symbol="ChevronLeft" FontSize="13"/>
                    <TextBlock Text="Back to inventory" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    Classes="accent"
                    Height="36"
                    Padding="20,0"
                    IsEnabled="{Binding !IsLoading}"
                    Command="{Binding ProceedToExecutionCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Proceed to execution" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ui:SymbolIcon Symbol="ChevronRight" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</UserControl>

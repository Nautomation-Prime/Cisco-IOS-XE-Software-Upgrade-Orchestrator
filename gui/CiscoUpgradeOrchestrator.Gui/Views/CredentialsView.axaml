<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:CiscoUpgradeOrchestrator.Gui.ViewModels"
             xmlns:models="using:CiscoUpgradeOrchestrator.Gui.Models"
             x:Class="CiscoUpgradeOrchestrator.Gui.Views.CredentialsView"
             x:DataType="vm:CredentialsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.fieldError">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,20,28,20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="SSH credentials vault" Classes="pageTitle"/>
                <TextBlock Text="Cross-platform AES-256-GCM encrypted vault (no .env file required). Apply presets directly to Stage 3 execution"
                           Classes="caption"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Classes="statusDot" IsVisible="{Binding IsVaultUnlocked}" Fill="{DynamicResource SuccessBrush}"/>
                <Ellipse Classes="statusDot" IsVisible="{Binding !IsVaultUnlocked}" Fill="{DynamicResource WarningBrush}"/>
                <TextBlock Text="Unlocked" IsVisible="{Binding IsVaultUnlocked}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Text="Locked" IsVisible="{Binding !IsVaultUnlocked}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Vault Unlock / Lock Control Card -->
        <Border Grid.Row="1" Classes="surfaceCard" Padding="20,16" Margin="0,0,0,16">
            <StackPanel Spacing="12" IsEnabled="{Binding !IsVaultBusy}">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsVaultUnlocked}">
                    <Grid Grid.Column="0" ColumnDefinitions="*,12,*" Margin="0,0,12,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding VaultPassword, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Height="32" CornerRadius="6"
                                 Watermark="Master password (min 12 chars for new vault)"
                                 VerticalContentAlignment="Center"/>
                        <TextBox Grid.Column="2"
                                 Text="{Binding VaultConfirmation, Mode=TwoWay}"
                                 IsVisible="{Binding NeedsVaultCreation}"
                                 PasswordChar="●"
                                 Height="32" CornerRadius="6"
                                 Watermark="Confirm new master password"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Classes="accent"
                            Height="32"
                            Padding="16,0"
                            Command="{Binding UnlockVaultCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:ProgressRing Width="12" Height="12" IsVisible="{Binding IsVaultBusy}"/>
                            <ui:SymbolIcon Symbol="Permissions" FontSize="13" IsVisible="{Binding !IsVaultBusy}"/>
                            <TextBlock Text="{Binding UnlockButtonText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsVaultUnlocked}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Classes="statusDot" Fill="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding VaultStatus}" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="subtle"
                            Height="32"
                            Padding="12,0"
                            Command="{Binding LockVaultCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:SymbolIcon Symbol="ProtectedDocument" FontSize="13"/>
                            <TextBlock Text="Lock vault" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Locked / Error Feedback -->
                <Border Classes="recessedBox" Padding="12,8" IsVisible="{Binding !IsVaultUnlocked}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="statusDot" IsVisible="{Binding HasVaultError}" Fill="{DynamicResource DangerBrush}"/>
                        <Ellipse Classes="statusDot" IsVisible="{Binding !HasVaultError}" Fill="{DynamicResource InfoBrush}"/>
                        <TextBlock Text="{Binding VaultStatus}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Split Workspace: Save Preset Form (Left) + Saved Presets Pool (Right) -->
        <Grid Grid.Row="2" ColumnDefinitions="380,16,*" IsEnabled="{Binding IsVaultUnlocked}">

            <!-- Left Card: Save Credential Preset -->
            <Border Grid.Column="0" Classes="surfaceCard" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Save credential preset" Classes="sectionTitle"/>
                        <TextBlock Text="Stored locally with AES-256-GCM and 600k PBKDF2 iterations" Classes="caption"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Profile label *" Classes="fieldLabel"/>
                        <TextBox Text="{Binding NewProfileName, Mode=TwoWay}"
                                 Height="32" CornerRadius="6"
                                 Watermark="e.g., Campus Core, Branch Lab"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding ProfileNameError}" IsVisible="{Binding HasProfileNameError}" Classes="fieldError"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="SSH username *" Classes="fieldLabel"/>
                        <TextBox Text="{Binding NewUsername, Mode=TwoWay}"
                                 Height="32" CornerRadius="6"
                                 Watermark="admin"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding UsernameError}" IsVisible="{Binding HasUsernameError}" Classes="fieldError"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="SSH password *" Classes="fieldLabel"/>
                        <TextBox Text="{Binding NewPassword, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Height="32" CornerRadius="6"
                                 Watermark="Device SSH password"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding PasswordError}" IsVisible="{Binding HasPasswordError}" Classes="fieldError"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Enable secret (optional)" Classes="fieldLabel"/>
                        <TextBox Text="{Binding NewSecret, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Height="32" CornerRadius="6"
                                 Watermark="Optional privilege 15 enable secret"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Classes="accent"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,0"
                            Command="{Binding SavePresetCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Save" FontSize="13"/>
                            <TextBlock Text="Save preset to vault" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="recessedBox" Padding="10,8" IsVisible="{Binding HasPresetFeedback}">
                        <TextBlock Text="{Binding PresetFeedback}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right Card: Saved Credentials Pool -->
            <Border Grid.Column="2" Classes="surfaceCard" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="20,16"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Saved SSH credential presets" Classes="sectionTitle"/>
                            <TextBlock Text="Click 'Apply to session' to load a preset into Stage 3 execution in memory (never written to disk)"
                                       Classes="caption"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding StoredCredentials}"
                                  IsVisible="{Binding HasStoredCredentials}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Profile" Binding="{Binding Name}" FontWeight="SemiBold" Width="170"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" FontFamily="{DynamicResource CodeFontFamily}" Width="140"/>
                                <DataGridCheckBoxColumn Header="Enable secret" Binding="{Binding HasSecret}" Width="115"/>
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:CredentialEntry">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="accent"
                                                        Height="28"
                                                        Padding="10,0"
                                                        Command="{Binding $parent[UserControl].((vm:CredentialsViewModel)DataContext).ApplyPresetToSessionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Apply to session" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Classes="subtle"
                                                        Height="28"
                                                        Padding="10,0"
                                                        Command="{Binding $parent[UserControl].((vm:CredentialsViewModel)DataContext).DeletePresetCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Delete" FontSize="11.5" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State -->
                        <StackPanel IsVisible="{Binding !HasStoredCredentials}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="6"
                                    Margin="32">
                            <TextBlock Text="No saved credential presets"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Unlock the vault above and save your switch SSH credentials on the left for 1-click session reuse"
                                       Classes="caption" TextAlignment="Center" MaxWidth="380"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
